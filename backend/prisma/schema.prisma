generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  COUNSELOR
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      Role     @default(STUDENT)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  eventRegistrations EventRegistration[]
  appointments     Appointment[]
  applications     Application[]
  documents        StudentDocument[]
}

model StudentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  studyLevel       String
  academicScore    Float
  englishTestType  String?
  englishScore     String?
  budget           String?
  preferredCountry String?
  phone            String?
  dateOfBirth      String?
  gender           String?
  nidOrPassport    String?
  sscBoard         String?
  sscGpa           String?
  sscYear          String?
  hscBoard         String?
  hscGpa           String?
  hscYear          String?
  undergradUni     String?
  undergradCgpa    String?
  undergradYear    String?
  ieltsListening   String?
  ieltsReading     String?
  ieltsWriting     String?
  ieltsSpeaking    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  eligibilityResults EligibilityResult[]
}

model Country {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  region    String
  status    String   @default("ACTIVE")

  universities University[]
}

model University {
  id        String   @id @default(uuid())
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  name      String
  status    String   @default("ACTIVE")

  courses Course[]

  @@index([countryId])
}

model Course {
  id                  String     @id @default(uuid())
  universityId        String
  university          University @relation(fields: [universityId], references: [id])
  name                String
  tuitionFee          Float?
  currency            String?
  degreeLevel         String?
  minIelts            Float?
  minGpa              Float?
  intakeMonths        String[]
  applicationDeadline DateTime?
  status              String     @default("ACTIVE")

  @@index([universityId])
}

model StudentDocument {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  type           String
  fileName       String
  fileKey        String
  mimeType       String
  fileSize       Int
  status         String   @default("UPLOADED")
  reviewFeedback String?
  reviewedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime?
  location    String?
  status      String   @default("UPCOMING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registrations EventRegistration[]
}

model EventRegistration {
  id                 String   @id @default(uuid())
  eventId            String?
  event              Event?   @relation(fields: [eventId], references: [id])
  userId             String?  // Optional, can be anonymous lead
  user               User?    @relation(fields: [userId], references: [id])
  name               String
  email              String
  phone              String
  degree             String?
  academicScore      String?
  englishProficiency String?
  venue              String?
  notes              String?
  countryOfInterest  String?
  createdAt          DateTime @default(now())
}

model Counselor {
  id               String   @id @default(uuid())
  name             String
  specializations  String[] // E.g. ['Hungary', 'UK']
  status           String   @default("ACTIVE")

  appointments Appointment[]
}

model Appointment {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  counselorId     String
  counselor       Counselor @relation(fields: [counselorId], references: [id])
  date            DateTime
  type            String    @default("FREE")
  durationMinutes Int       @default(15)
  fee             Float     @default(0)
  paymentStatus   String    @default("NOT_REQUIRED")
  trxId           String?
  status          String    @default("SCHEDULED")

  @@index([userId])
  @@index([counselorId])
}

model Application {
  id         String   @id @default(uuid())
  trackingId String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  country    String
  university String
  program    String
  track      String   @default("SELF_APPLY")
  fee        Float    @default(0)
  status     String   @default("SUBMITTED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Lead {
  id                 String   @id @default(uuid())
  userId             String?  // Link if registered
  name               String?
  email              String?
  phone              String?
  studyLevel         String?
  academicScore      String?
  englishScore       String?
  budget             String?
  source             String   @default("WEBSITE")
  preferredCountry   String?
  recommendedCountry String?
  university         String?
  alternativePathway String?
  eligibilityStatus  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model EligibilityResult {
  id                 String         @id @default(uuid())
  studentProfileId   String
  studentProfile     StudentProfile @relation(fields: [studentProfileId], references: [id])
  resultStatus       String
  matchedCountry     String?
  matchedUniversity  String?
  alternativePathway String?
  ruleVersion        String
  createdAt          DateTime       @default(now())
}
