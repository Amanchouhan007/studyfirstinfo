# ==============================================================================
# Study First Info - Production & Development Environment Configuration
# ==============================================================================

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Server Port (defaults to 5000 if not specified)
PORT=5000

# ------------------------------------------------------------------------------
# Reverse Proxy Configuration (Express trust proxy)
# Set to 1 when the backend runs behind a reverse proxy or platform (Railway, Render, Nginx, Cloudflare). Leave empty when exposed directly. Wrong value breaks rate limiting.
# ------------------------------------------------------------------------------
# TRUST_PROXY=1

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL with Prisma) - REQUIRED
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studyfirstinfo?schema=public&connection_limit=20"

# ------------------------------------------------------------------------------
# Authentication & JWT Security - REQUIRED
# Server will refuse to start if this is missing.
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_64_character_string

# ------------------------------------------------------------------------------
# Client Frontend Application URL
# Allowed CORS origin. Required in production. Defaults to http://localhost:5173 in dev.
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
# Optional legacy CORS fallback origin
# VITE_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Profile At-Rest Data Encryption (AES-256-GCM)
# 64-character hexadecimal string (32 bytes).
# Required in production for encrypting National ID and Passport numbers at rest.
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
PROFILE_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# Private Document Storage (S3 / Cloudflare R2 / AWS S3) - OPTIONAL
# If these 4 variables are present, S3-compatible cloud storage driver is activated.
# If absent, local disk driver (backend/uploads, git-ignored) is used automatically.
# ------------------------------------------------------------------------------
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=studyfirstinfo-documents
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
